    "jose": "^6.2.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "undici": "^7.24.3",
    "zod": "^4.3.6",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
