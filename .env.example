# ============================================================
# Hirelix Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database (self-hosted VPS Postgres) ----
# Used by Drizzle ORM to read/write all hirelix_* business tables AND the
# better-auth identity tables (user, session, account, verification).
DATABASE_URL=postgresql://hirelix_app:STRONG_PASSWORD@VPS_HOST:5432/hirelix?sslmode=require
# Optional connection pool tuning (postgres.js)
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT=30
# DATABASE_CONNECT_TIMEOUT=10
# Set to "false" to skip SSL for local development against a loopback Postgres.
# DATABASE_SSL=false

# ---- better-auth (Google sign-in via OAuth) ----
# Random 32-byte secret used to sign session cookies / state tokens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
# Public origin of the app — used to build OAuth redirect URIs.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth Client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URIs must include: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ---- AI Provider (deepseek by default; OpenRouter is optional fallback) ----
AI_PROVIDER=deepseek
AI_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high
OPENROUTER_API_KEY=your_openrouter_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://hirelix.com
# OPENROUTER_X_TITLE=Hirelix

# ---- AI Model Selection (per stage) ----
SEARCH_LIGHT_MODEL=deepseek-v4-flash
SEARCH_JUDGE_MODEL=deepseek-v4-flash
SEARCH_ARBITER_MODEL=deepseek-v4-pro
SEARCH_PARSE_THINKING=disabled
SEARCH_OUTREACH_THINKING=disabled
SEARCH_JUDGE_REASONING_EFFORT=high
SEARCH_ARBITER_REASONING_EFFORT=max
# OPENROUTER_JUDGE_MODEL=
# OPENROUTER_ARBITER_MODEL=
# OPENROUTER_LIGHT_MODEL=
# DEEPSEEK_JUDGE_MODEL=
# DEEPSEEK_ARBITER_MODEL=
# DEEPSEEK_LIGHT_MODEL=

# ---- Anthropic (used for complex arbitration) ----
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=sk-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- External Services ----
BRIGHTDATA_API_TOKEN=your_brightdata_token
BRIGHTDATA_DATASET_ID=your_dataset_id
# BRIGHTDATA_RECALL_DATASET_ID=          # optional, falls back to BRIGHTDATA_DATASET_ID
HUNTER_API_KEY=your_hunter_key
GITHUB_TOKEN=your_github_pat
# APOLLO_API_KEY=                         # optional
# PDL_API_KEY=                            # optional
# SERPER_API_KEY=                         # optional, GitHub identity discovery fallback only

# ---- Paddle Billing ----
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_STARTER_MONTHLY_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_STARTER_ANNUAL_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_PRO_ANNUAL_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_SEARCH_PACK_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_CONTACT_PACK_PRICE_ID=pri_xxx
PADDLE_WEBHOOK_SECRET=your_webhook_secret

# ---- Notifications ----
SEARCH_NOTIFICATIONS_ENABLED=true
# NEXT_PUBLIC_SEARCH_NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=your_resend_key
SEARCH_NOTIFICATIONS_FROM_EMAIL=notifications@yourdomain.com
# Optional: admin alert when a real Paddle subscription starts.
BILLING_SUBSCRIPTION_ALERT_EMAIL=jzh_spring@163.com
# Optional, falls back to SEARCH_NOTIFICATIONS_FROM_EMAIL.
# BILLING_ALERTS_FROM_EMAIL=billing@yourdomain.com

# ---- App ----
APP_BASE_URL=https://hirelix.online
ADMIN_EMAIL=your_admin_email@example.com
# Long random path secret for the read-only /ops/[secret] conversion dashboard.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPS_DASHBOARD_SECRET=replace_with_a_long_random_secret

# ---- Network Proxy (local dev only, not for production) ----
# PROXY_ENABLED=true
# PROXY_URL=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ============================================================
# Search Pipeline Tuning (all optional, shown with defaults)
# ============================================================

# Bright Data recall profile
# SEARCH_EXECUTION_MODE=test              # test locally, production on Vercel unless overridden
# SEARCH_TEST_BRIGHTDATA_STANDARD_LIMIT=50
# SEARCH_TEST_BRIGHTDATA_HIDDEN_GEM_LIMIT=25
# SEARCH_TEST_BRIGHTDATA_COMPANY_TARGET_LIMIT=25
# SEARCH_PRODUCTION_BRIGHTDATA_STANDARD_LIMIT=200
# SEARCH_PRODUCTION_BRIGHTDATA_HIDDEN_GEM_LIMIT=100
# SEARCH_PRODUCTION_BRIGHTDATA_COMPANY_TARGET_LIMIT=100
# SEARCH_BRIGHTDATA_STANDARD_LIMIT=50     # legacy fallback for standard round
# SEARCH_BRIGHTDATA_HIDDEN_GEM_LIMIT=25   # legacy fallback for hidden-gem round
# SEARCH_BRIGHTDATA_COMPANY_TARGET_LIMIT=25 # legacy fallback for company-target round
# SEARCH_BRIGHTDATA_FILTER_LIMIT=50       # legacy fallback for standard round
# BRIGHTDATA_SNAPSHOT_CACHE_TTL_DAYS=14   # DB-first snapshot reuse window; capped at 30 days

# Shortlist quality gates
# SEARCH_SHORTLIST_MATCH_SCORE_MIN=60
# SEARCH_SHORTLIST_RELEVANCE_MIN=75
# SEARCH_SHORTLIST_CAPABILITY_MIN=70
# SEARCH_SHORTLIST_JOIN_LIKELIHOOD_MIN=55

# Concurrency and batching
# SEARCH_FAST_JUDGE_BATCH_SIZE=20
# SEARCH_FAST_JUDGE_CONCURRENCY=8
# SEARCH_SECOND_REVIEW_MIN=20
# SEARCH_SECOND_REVIEW_MAX=40
# SEARCH_DEEP_SCORING_BATCH_SIZE=10
# SEARCH_DEEP_SCORING_CONCURRENCY=6
# SEARCH_DEEP_REVIEW_CONCURRENCY=6
# SEARCH_DEEP_CACHE_PRIMER_COUNT=0
# SEARCH_LLM_GLOBAL_CONCURRENCY=12
# SEARCH_LLM_MAX_ATTEMPTS=4
# SEARCH_LLM_RETRY_BASE_MS=2000
# SEARCH_LLM_RETRY_MAX_MS=30000
# SEARCH_GITHUB_ENRICH_LIMIT=20
# SEARCH_OUTREACH_POOL_TARGET=25
# SEARCH_HIGHLIGHT_COUNT=5

# Timeouts
# SEARCH_JUDGE_SCORING_TIMEOUT_MS=300000
# SEARCH_ARBITER_SCORING_TIMEOUT_MS=300000
# SEARCH_BRIGHTDATA_FILTER_TIMEOUT_MS=900000
# SEARCH_BRIGHTDATA_FILTER_POLL_INTERVAL_MS=5000
# SEARCH_BRIGHTDATA_REQUEST_TIMEOUT_MS=30000

# Token limits
# SEARCH_PARSE_MAX_OUTPUT_TOKENS=1800
# SEARCH_JUDGE_MAX_OUTPUT_TOKENS=1200
# SEARCH_ARBITER_MAX_OUTPUT_TOKENS=800
# SEARCH_ESTIMATED_DEEPSEEK_PRO_INPUT_COST_PER_1M=1.74
# SEARCH_ESTIMATED_DEEPSEEK_PRO_OUTPUT_COST_PER_1M=3.48

# Misc
# SEARCH_PARSE_MAX_ATTEMPTS=2
# SEARCH_FULL_STAGE_PARALLELISM=false
# SEARCH_LOW_COST_MODE=false
# SEARCH_DEBUG_DEEP_REVIEW_LOGS=false
# SEARCH_ESTIMATED_TOKENS_PER_CHAR=0.25
# SEARCH_ESTIMATED_DEEP_REVIEW_CONFLICT_RATE=0.15
# SEARCH_ESTIMATED_DEEPSEEK_INPUT_COST_PER_1M=0.14
# SEARCH_ESTIMATED_DEEPSEEK_OUTPUT_COST_PER_1M=0.28

# Job scheduler
# SEARCH_JOB_SCHEDULER_CONCURRENCY=1
# SEARCH_JOB_STALE_MINUTES=20
# SEARCH_JOB_STARTUP_STALL_SECONDS=60
# SEARCH_JOB_HEARTBEAT_SECONDS=30
# SEARCH_JOB_SCHEDULER_ENABLED=           # auto-enabled in production
# SEARCH_JOB_RUNNER_KICK_ENABLED=         # auto-enabled in production
# SEARCH_JOB_RUNNER_BASE_URL=             # auto-resolved in production

# GitHub enrichment
# GITHUB_TRACE_LOGS=                      # comma-separated usernames for debug tracing
